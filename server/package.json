{
	"name": "elysia",
	"version": "1.0.50",
	"scripts": {
		"test": "bun test",
		"test:watch": "bun test --watch",
		"dev": "bun run --watch src/index.ts",
		"db:generate": "drizzle-kit generate",
		"db:push": "drizzle-kit push",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"db:seed": "bun run ./src/db/seed.ts",
		"biome:check": "bunx --bun @biomejs/biome check --write",
		"biome:format": "bunx --bun @biomejs/biome format --write",
		"biome:lint": "bunx --bun @biomejs/biome lint --write"
	},
	"dependencies": {
		"@bogeychan/elysia-logger": "^0.1.10",
		"@elysia/cors": "^1.4.2",
		"@elysia/eden": "^1.4.10",
		"@elysia/openapi": "^1.4.15",
		"drizzle-orm": "^1.0.0-rc.4",
		"elysia": "latest",
		"pg": "^8.22.0",
		"uuidv7": "^1.2.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.7",
		"@types/pg": "^8.20.0",
		"bun-types": "latest",
		"drizzle-kit": "^1.0.0-rc.4",
		"pino-pretty": "^13.1.3"
	},
	"module": "src/index.js"
}
